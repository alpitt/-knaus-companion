{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpitt.github.io/-knaus-companion/data/kb_manifest.schema.json",
  "title": "Knaus Companion Engineering Canon manifest",
  "description": "Governance contract for First Edition KB-001 to KB-250 and Second Edition KB2-001 to KB2-025 Engineering Canon records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "expectedFirstEditionCount",
    "expectedSecondEditionCount",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expectedFirstEditionCount": {
      "const": 250
    },
    "expectedSecondEditionCount": {
      "const": 25
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "kbIdentifier": {
      "type": "string",
      "pattern": "^(KB-(00[1-9]|0[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|250)|KB2-(00[1-9]|01[0-9]|02[0-5]))$"
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "revisionHistoryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "status", "changedAt", "changedBy", "summary", "checksum"],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["draft", "verified", "approved", "deprecated", "superseded"]
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        },
        "changedBy": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "method", "verifiedBy", "verifiedAt"],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "verifiedBy": {
          "type": "string",
          "minLength": 1
        },
        "verifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "edition",
        "sequence",
        "title",
        "revision",
        "status",
        "source",
        "provenance",
        "checksum",
        "contentPath",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/kbIdentifier"
        },
        "edition": {
          "enum": ["first", "second"]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["draft", "verified", "approved", "deprecated", "superseded"]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "contentPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^app/data/kb-content/[A-Za-z0-9._/-]+\\.json$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "revisionHistory": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revisionHistoryEntry"
          }
        },
        "relatedKbIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kbIdentifier"
          }
        },
        "relatedChapterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 44
          }
        },
        "relatedManualPages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 286
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceClassification": {
          "enum": [
            "owner-confirmed",
            "photograph-confirmed",
            "plate-confirmed",
            "manual-reference",
            "estimated",
            "unknown"
          ]
        },
        "confidenceLevel": {
          "enum": ["high", "medium", "low", "unknown"]
        },
        "supersededBy": {
          "oneOf": [
            {
              "$ref": "#/$defs/kbIdentifier"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "edition": {
                "const": "first"
              }
            },
            "required": ["edition"]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^KB-(00[1-9]|0[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|250)$"
              },
              "sequence": {
                "maximum": 250
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "edition": {
                "const": "second"
              }
            },
            "required": ["edition"]
          },
          "then": {
            "properties": {
              "id": {
                "pattern": "^KB2-(00[1-9]|01[0-9]|02[0-5])$"
              },
              "sequence": {
                "maximum": 25
              }
            }
          }
        }
      ]
    }
  }
}
