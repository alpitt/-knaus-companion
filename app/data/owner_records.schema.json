{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpitt.github.io/-knaus-companion/data/owner_records.schema.json",
  "title": "Knaus Companion owner record",
  "type": "object",
  "required": ["id", "type", "title", "status", "createdAt", "updatedAt", "confidence", "provenance"],
  "properties": {
    "id": {"type":"string","pattern":"^OR-[A-Z0-9][A-Z0-9-]{7,63}$"},
    "type": {"enum":["observation","maintenance","repair","modification","fault","inspection","measurement","workshop-job","part-replacement","service","document-note","photograph-note"]},
    "title": {"type":"string","minLength":1,"maxLength":160},
    "description": {"type":"string","maxLength":10000},
    "status": {"enum":["draft","open","investigating","planned","scheduled","in-progress","awaiting-parts","awaiting-workshop","completed","resolved","monitored","deferred","cancelled","archived","verified","reversed"]},
    "systemId": {"type":"string","maxLength":100},
    "componentIds": {"type":"array","uniqueItems":true,"items":{"type":"string","maxLength":100}},
    "relatedRecordIds": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "relatedFaultIds": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "relatedMaintenanceIds": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "relatedModificationIds": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "evidenceRefs": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "documentRefs": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "photographRefs": {"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "manualPageRefs": {"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":286}},
    "chapterRefs": {"type":"array","uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":44}},
    "kbRefs": {"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^(KB-[0-9]{3}|KB2-[0-9]{3})$"}},
    "createdAt": {"type":"string","format":"date-time"}, "updatedAt": {"type":"string","format":"date-time"},
    "occurredAt": {"type":"string","format":"date-time"}, "completedAt": {"type":"string","format":"date-time"},
    "plannedDate":{"type":"string","format":"date"}, "dueDate":{"type":"string","format":"date"}, "nextDueDate":{"type":"string","format":"date"},
    "intervalMonths":{"type":"integer","minimum":1}, "intervalDistance":{"$ref":"#/$defs/distance"},
    "odometer": {"$ref":"#/$defs/distance"}, "odometerDue":{"$ref":"#/$defs/distance"}, "odometerCompleted":{"$ref":"#/$defs/distance"}, "nextDueOdometer":{"$ref":"#/$defs/distance"},
    "location":{"type":"string","maxLength":300}, "supplier":{"type":"string","maxLength":300}, "workshop":{"type":"string","maxLength":300},
    "cost":{"type":"number","minimum":0}, "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
    "parts":{"type":"array","items":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1},"quantity":{"type":"number","minimum":0},"partNumber":{"type":"string"},"notes":{"type":"string"}},"additionalProperties":true}},
    "measurements":{"type":"array","items":{"$ref":"#/$defs/measurement"}},
    "findings":{"type":"string","maxLength":10000}, "actions":{"type":"string","maxLength":10000}, "result":{"type":"string","maxLength":5000},
    "reportedSymptom":{"type":"string","maxLength":5000}, "recurrenceCount":{"type":"integer","minimum":0}, "severity":{"enum":["low","medium","high","critical"]}, "safetyClass":{"enum":["informational","caution","safety-critical"]}, "diagnosticObservations":{"type":"string","maxLength":10000}, "suspectedCauses":{"type":"array","items":{"type":"string"}}, "confirmedCause":{"type":"string","maxLength":5000}, "finalRepair":{"type":"string","maxLength":10000},
    "originalConfiguration":{"type":"string","maxLength":10000}, "newConfiguration":{"type":"string","maxLength":10000}, "wiringChanges":{"type":"string","maxLength":10000}, "fuseChanges":{"type":"string","maxLength":5000}, "safetyImplications":{"type":"string","maxLength":5000}, "weightImplications":{"type":"string","maxLength":5000}, "electricalLoadImplications":{"type":"string","maxLength":5000}, "rollbackNotes":{"type":"string","maxLength":5000},
    "confidence":{"enum":["confirmed","high","medium","low","unknown"]},
    "provenance":{"enum":["owner-entry","owner-observation","measurement","photograph","invoice","receipt","service-record","workshop-report","manufacturer-document","official-manual","inferred","imported","unknown"]},
    "tags":{"type":"array","uniqueItems":true,"items":{"type":"string","maxLength":60}}, "notes":{"type":"string","maxLength":10000},
    "archived":{"type":"boolean"}, "deletedAt":{"type":"string","format":"date-time"},
    "revision":{"type":"integer","minimum":1}, "history":{"type":"array","items":{"$ref":"#/$defs/revision"}},
    "metadata":{"type":"object","additionalProperties":true}
  },
  "additionalProperties": true,
  "$defs": {
    "distance":{"type":"object","required":["value","unit"],"properties":{"value":{"type":"number","minimum":0},"unit":{"enum":["km","mi"]}},"additionalProperties":false},
    "measurement":{"type":"object","required":["category","value","unit","measuredAt"],"properties":{"id":{"type":"string"},"category":{"enum":["battery-voltage","charging-voltage","current","power","temperature","pressure","water-level","gas-level","fuel-level","tyre-pressure","weight","distance","time","custom"]},"value":{"type":"number"},"unit":{"type":"string","minLength":1,"maxLength":20},"measuredAt":{"type":"string","format":"date-time"},"systemId":{"type":"string"},"componentId":{"type":"string"},"conditions":{"type":"string"},"instrument":{"type":"string"},"confidence":{"enum":["confirmed","high","medium","low","unknown"]},"evidenceRefs":{"type":"array","items":{"type":"string"}},"notes":{"type":"string"}},"additionalProperties":true},
    "revision":{"type":"object","required":["revisionId","recordId","revisionNumber","changedAt","changeType","changedFields","previousValues","newValues","source","notes"],"properties":{"revisionId":{"type":"string"},"recordId":{"type":"string"},"revisionNumber":{"type":"integer","minimum":1},"changedAt":{"type":"string","format":"date-time"},"changeType":{"enum":["created","updated","status-changed","linked","unlinked","archived","restored","imported","migrated"]},"changedFields":{"type":"array","items":{"type":"string"}},"previousValues":{"type":"object"},"newValues":{"type":"object"},"source":{"type":"string"},"notes":{"type":"string"}},"additionalProperties":false}
  }
}
